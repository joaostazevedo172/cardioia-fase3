    {
        "id": "fn_registrar_evento",
        "type": "function",
        "z": "aba_cardioia",
        "name": "acumular eventos",
        "func": "// Mantem as ultimas 20 ocorrencias no contexto do flow. O historico\n// vive no Node-RED, nao no dispositivo: o ESP32 tem memoria para\n// resiliencia, nao para consulta clinica.\n\nconst d = msg.payload;\nconst lista = flow.get('eventos') || [];\n\nlista.unshift({\n    hora: new Date().toLocaleTimeString('pt-BR'),\n    motivo: d.motivo,\n    bpm: d.bpm,\n    temp: d.temp,\n    origem: d.origem === 'historico' ? 'sincronizado' : 'ao vivo'\n});\n\nif (lista.length > 20) { lista.length = 20; }\nflow.set('eventos', lista);\n\nmsg.payload = lista;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 340,
        "wires": [
            [
                "ui_tabela_eventos"
            ]
        ]
    },
    {
        "id": "ui_tabela_eventos",
        "type": "ui_template",
        "z": "aba_cardioia",
        "group": "grp_historico",
        "name": "Tabela de eventos",
        "order": 1,
        "width": "6",
        "height": "6",
        "format": "<table style=\"width:100%;border-collapse:collapse;font-size:13px\">\n  <thead>\n    <tr style=\"text-align:left;border-bottom:1px solid rgba(128,128,128,.4)\">\n      <th style=\"padding:6px 4px\">Hora</th>\n      <th style=\"padding:6px 4px\">Motivo</th>\n      <th style=\"padding:6px 4px\">FC</th>\n      <th style=\"padding:6px 4px\">Temp</th>\n      <th style=\"padding:6px 4px\">Origem</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr ng-repeat=\"e in msg.payload\" style=\"border-bottom:1px solid rgba(128,128,128,.15)\">\n      <td style=\"padding:5px 4px\">{{e.hora}}</td>\n      <td style=\"padding:5px 4px;color:#d50000;font-weight:600\">{{e.motivo}}</td>\n      <td style=\"padding:5px 4px\">{{e.bpm}}</td>\n      <td style=\"padding:5px 4px\">{{e.temp}}</td>\n      <td style=\"padding:5px 4px;opacity:.7\">{{e.origem}}</td>\n    </tr>\n    <tr ng-if=\"!msg.payload || msg.payload.length === 0\">\n      <td colspan=\"5\" style=\"padding:14px 4px;opacity:.6\">Nenhum evento clinico registrado.</td>\n    </tr>\n  </tbody>\n</table>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
