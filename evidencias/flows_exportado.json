    {
        "id": "ui_painel_alerta",
        "type": "ui_template",
        "z": "aba_cardioia",
        "group": "grp_alerta",
        "name": "LED virtual de alerta",
        "order": 1,
        "width": "6",
        "height": "4",
        "format": "<div style=\"display:flex;align-items:center;gap:16px;padding:8px\">\n  <div ng-style=\"{'background': msg.payload.alerta ? '#d50000' : '#00c853',\n                  'box-shadow': msg.payload.alerta ? '0 0 22px 6px rgba(213,0,0,.8)' : '0 0 10px 2px rgba(0,200,83,.5)'}\"\n       style=\"width:58px;height:58px;border-radius:50%;flex:none;transition:all .25s\"></div>\n  <div>\n    <div style=\"font-size:20px;font-weight:700\">{{msg.payload.motivo || 'AGUARDANDO'}}</div>\n    <div style=\"opacity:.75;font-size:13px\">\n      FC {{msg.payload.bpm}} bpm &nbsp;|&nbsp; {{msg.payload.temp}} C &nbsp;|&nbsp; {{msg.payload.mov}} mg\n    </div>\n  </div>\n</div>",
