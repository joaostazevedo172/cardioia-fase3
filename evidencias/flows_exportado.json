    {
        "id": "fn_normalizar",
        "type": "function",
        "z": "aba_cardioia",
        "name": "normalizar e rotear",
        "func": "// Recebe o JSON publicado pelo ESP32 e distribui pelas saidas do\n// dashboard. Amostras do backlog (origem 'historico') nao atualizam os\n// medidores: elas sao passado, e um gauge mostrando valor antigo como se\n// fosse atual induziria o profissional ao erro. Elas alimentam apenas o\n// grafico, que e uma serie temporal e sabe onde posicionar o ponto.\n\nconst d = msg.payload;\nif (!d || typeof d !== 'object') { return null; }\n\nconst aovivo = (d.origem !== 'historico');\n\n// 1 - grafico de frequencia cardiaca\nconst grafico = { payload: d.bpm, topic: aovivo ? 'FC ao vivo' : 'FC sincronizada' };\n\n// 2 e 3 - medidores (so ao vivo)\nconst temperatura = aovivo ? { payload: d.temp } : null;\nconst umidade     = aovivo ? { payload: d.umid } : null;\n\n// 4 - indicador de alerta\nconst indicador = {\n    payload: {\n        alerta: d.alerta === true,\n        motivo: d.motivo || 'NORMAL',\n        bpm: d.bpm,\n        temp: d.temp,\n        mov: d.mov\n    }\n};\n\n// 5 - fila de sincronizacao pendente\nconst backlog = { payload: d.backlog || 0, perdidas: d.perdidas || 0 };\n\nreturn [ grafico, temperatura, umidade, indicador, backlog ];",
        "outputs": 5,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 160,
        "wires": [
            [
                "ui_grafico_fc"
            ],
            [
                "ui_gauge_temp"
            ],
            [
                "ui_gauge_umid"
            ],
            [
                "ui_painel_alerta"
            ],
            [
                "ui_backlog"
            ]
        ]
    },
