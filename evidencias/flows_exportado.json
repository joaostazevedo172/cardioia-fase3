    {
        "id": "fn_status",
        "type": "function",
        "z": "aba_cardioia",
        "name": "estado do dispositivo",
        "func": "// O topico de status carrega a mensagem retida do dispositivo e tambem\n// o Last Will publicado pelo broker caso o ESP32 pare sem se despedir.\n// Distinguir 'sem alteracoes' de 'parei de receber' e essencial num\n// monitor cardiaco: a segunda situacao e uma emergencia silenciosa.\n\nconst e = (msg.payload && msg.payload.estado) || 'desconhecido';\nmsg.payload = (e === 'online')\n    ? 'ONLINE - recebendo telemetria'\n    : 'OFFLINE - dispositivo sem comunicacao';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 420,
        "wires": [
            [
                "ui_status"
            ]
        ]
    },
